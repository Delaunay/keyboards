 * Copyright (c) 2026 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Split v2, from keyboard.kicad_pcb.
 * Diodes point from the column, through the switch, to the row (col2row).
 *
 * nice!nano v2 Pro Micro pads, USB at the top.
 * Left row, top to bottom, is pads 1-12. Right row is pads 13-24.
 *   pad 2   D0   ENC_BTN   encoder push, extra matrix row on COL_MACRO
 *   pad 5   D2   ENC_B
 *   pad 6   D3   ENC_A
 *   pad 7   D4   ROW_FN
 *   pad 8   D5   ROW_NUMS
 *   pad 9   D6   ROW_TOP
 *   pad 10  D7   ROW_HOME
 *   pad 11  D8   COL_PINKY
 *   pad 12  D9   ROW_BOT
 *   pad 17  A3   COL_INNER
 *   pad 18  A2   ROW_THUMB
 *   pad 19  A1   COL_INDEX
 *   pad 20  A0   COL_MIDDLE
 *   pad 21  D15  COL_RING
 *   pad 22  D14  COL_MACRO
 *
 * The encoder push is wired between COL_MACRO and D0, with no diode.
 * D0 is scanned as its own row, so only the macro column has that key.
 *
 * steps = 120 and 30 triggers match a 30-detent EC11 (4 counts per detent).
 * If a click does nothing or fires twice, try steps of 60 or 80.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "splitv2-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW_FN    */
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW_NUMS  */
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW_TOP   */
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW_HOME  */
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW_BOT   */
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* ROW_THUMB */
            , <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ENC_BTN   */
            ;

        col-gpios
            = <&pro_micro 14 GPIO_ACTIVE_HIGH> /* COL_MACRO  */
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>  /* COL_PINKY  */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH> /* COL_RING   */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH> /* COL_MIDDLE */
            , <&pro_micro 19 GPIO_ACTIVE_HIGH> /* COL_INDEX  */
            , <&pro_micro 21 GPIO_ACTIVE_HIGH> /* COL_INNER  */
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <7>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)  RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
            RC(5,2) RC(5,3) RC(5,4) RC(5,5)                  RC(5,6) RC(5,7) RC(5,8) RC(5,9)
            RC(6,0)                                          RC(6,11)
        >;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <120>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <120>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <30>;
    };
};

&physical_layout0 {
    transform = <&default_transform>;
};
