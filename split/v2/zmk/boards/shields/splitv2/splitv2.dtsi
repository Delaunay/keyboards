/*
 * Copyright (c) 2026 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Shared by both halves and the XIAO BLE dongle.
 * GPIO lives in splitv2_pro_micro.dtsi. The dongle has no Pro Micro pins.
 *
 * Diodes point from the column, through the switch, to the row (col2row).
 * triggers-per-rotation = 30 matches a 30-detent EC11 with steps = 120
 * on the halves. If a click does nothing or fires twice, try steps of
 * 60 or 80 in splitv2_pro_micro.dtsi.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "splitv2-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <7>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)  RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
            RC(5,2) RC(5,3) RC(5,4) RC(5,5)                  RC(5,6) RC(5,7) RC(5,8) RC(5,9)
            RC(6,0)                                          RC(6,11)
        >;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <30>;
    };
};

&physical_layout0 {
    transform = <&default_transform>;
};
